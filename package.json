{
  "name": "claude-editing-motion-remotion",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A hand-drawn editing workflow recreated with Remotion and SVG",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "render": "remotion render src/index.ts ClaudeEditingMotion out/claude-editing-motion.mp4 --codec=h264 --crf=18 --concurrency=4",
    "still": "remotion still src/index.ts ClaudeEditingMotion out/still.png --frame=885",
    "verify": "node scripts/verify-output.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
